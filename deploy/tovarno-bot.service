[Unit]
Description=TOVARNO Telegram demo bot
After=network-online.target
Wants=network-online.target

[Service]
User=tovarno
Group=tovarno
Environment=INTAKE_DB=/var/lib/tovarno/intake.sqlite3
Environment=INTAKE_UPLOAD_DIR=/var/lib/tovarno/uploads
ReadWritePaths=/var/lib/tovarno
Environment=PUBLIC_URL=https://app.moyskladdemo.xyz/
EnvironmentFile=/etc/tovarno/bot.env
ExecStart=/usr/bin/python3 /opt/tovarno/telegram_demo_bot.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
